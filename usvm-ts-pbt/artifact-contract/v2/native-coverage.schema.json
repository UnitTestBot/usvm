{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usvm.dev/ts-pbt/artifact-contract/v2/native-coverage.schema.json",
  "title": "Native adapter coverage claims v2",
  "type": "object",
  "required": ["schemaVersion", "producer", "claims"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "producer": { "$ref": "#/$defs/producer" },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "diagnostics": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true,
  "$defs": {
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": ["methodId", "nativeTargetId", "claimedCovered"],
      "properties": {
        "methodId": { "type": "string", "minLength": 1 },
        "nativeTargetId": { "type": "string", "minLength": 1 },
        "claimedCovered": { "type": "boolean" },
        "discoveredAtMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  }
}
