{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usvm.dev/ts-pbt/artifact-contract/v2/run-meta.schema.json",
  "title": "Raw adapter run metadata v2",
  "type": "object",
  "required": ["schemaVersion", "runId", "producer", "startupMs", "generationMs", "exportMs", "totalMs", "commits", "exitStatus", "timedOut", "logCapBytes", "logTruncated", "overBudgetMs"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "runId": { "type": "string", "minLength": 1 },
    "producer": { "$ref": "#/$defs/producer" },
    "startupMs": { "type": "integer", "minimum": 0 },
    "generationMs": { "type": "integer", "minimum": 0 },
    "exportMs": { "type": "integer", "minimum": 0 },
    "totalMs": { "type": "integer", "minimum": 0 },
    "commits": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
    "exitStatus": { "enum": ["success", "unsupported_configuration", "tool_failure", "timeout_partial_corpus"] },
    "timedOut": { "type": "boolean" },
    "logCapBytes": { "type": "integer", "minimum": 1 },
    "logTruncated": { "type": "boolean" },
    "overBudgetMs": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true,
  "$defs": {
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
